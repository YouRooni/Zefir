<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_off"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="12dp">

    <ImageView
        android:id="@+id/widget_toggle"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_widget_power"
        android:tint="@color/w_on_surface"
        android:contentDescription="@string/widget_connect" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:maxLines="1"
            android:textColor="@color/w_on_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_server"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:alpha="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/w_on_surface_var"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
